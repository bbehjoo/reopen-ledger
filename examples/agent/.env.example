# Copy to .env (gitignored) and fill in. Never commit the real file.
# The wallet that signs your records: hex private key of a Base wallet holding a little ETH for gas.
PRIVATE_KEY=
# Your own Builder Code(s), comma separated; the project's code is added after them.
BUILDER_CODES=
# Optional: any Base mainnet RPC.
RPC_URL=https://mainnet.base.org
